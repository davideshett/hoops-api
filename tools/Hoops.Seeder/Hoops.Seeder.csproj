<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Hoops.Seeder</RootNamespace>
    <!-- A dev tool, not a library: XML docs would be noise. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Deliberately NO project references. The seeder is a client of the HTTP API, exactly like
         a scorer's-table app would be, so it can only create data the API would accept — and it
         doubles as an end-to-end smoke test. The one exception is a single SQL statement to grant
         platform-admin, which has no endpoint by design. -->
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

</Project>
